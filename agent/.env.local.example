# ------------------------------------------------------------------------------
# Voice-agent configuration. Copy to .env.local and fill in.
#
# Out of the box every integration is OFF — the agent starts with only its built-in
# conversational tools and no home devices. Enable an integration by linking it with the
# guided setup, which stores its secrets here and flips its <NAME>_ENABLED flag for you:
#     python agent/onboard.py <opencode|wiz|nest|tesla|ring|tv|petlibro|roomba>
# ------------------------------------------------------------------------------

# ---- core infrastructure (required) ----
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_PUBLIC_URL=wss://your-host:8443
OPENAI_BASE_URL=http://127.0.0.1:11434/v1     # default: local Ollama (setup.sh installs it);
                                               #   any OpenAI-compatible endpoint with tool calling works
OPENAI_API_KEY=ollama                          # any non-empty value for local servers
LLM_MODEL=qwen3.5:9b-mlx
LLM_REASONING_EFFORT=none                      # REQUIRED for hybrid-thinking models (qwen3.5):
                                               #   without it the model "thinks" 10-30s before
                                               #   speaking. Remove if your endpoint rejects it.
OPENCODE_MODEL=                                # model for dispatched opencode sessions (blank = use LLM_MODEL)

# ---- remote access (public tunnel + TURN relay for voice through NAT; see docs) ----
NGROK_DOMAIN=                                   # your reserved ngrok domain (blank = random URL)
TURN_VPS=                                        # your public TURN relay host (shown in status)
TURN_USERNAME=
TURN_PASS=
TURN_PUBLIC_HOST=
TURN_LAN_HOST=

# ---- web gate (password for the public URL; set via the web-auth setup) ----
WEB_AUTH_SECRET=
WEB_AUTH_PWHASH=

# ---- token server (only relevant if you expose :8790 publicly, e.g. a hardware client) ----
# WATCH_TOKEN_KEY=                             # shared secret a NON-LAN caller must pass as
#                                              #   ?key=... to mint a room token. Blank = remote
#                                              #   token requests are denied outright (browsers via
#                                              #   Caddy are loopback, so they're unaffected).
# TOKEN_LOCAL_CIDRS=                           # comma-separated CIDRs trusted key-free
#                                              #   (default: loopback + 192.168/16 + 172.16/12 +
#                                              #   10.0.0.0/24). Set to your LAN's /24 if it's a
#                                              #   different 10.x subnet — do NOT use all of 10/8.

# ---- voice pipeline (optional; defaults shown are the tuned/live values) ----
STT_ENGINE=parakeet                            # parakeet (recommended) | whisper | qwen3-asr
POCKET_VOICE=jean                              # pocket-tts voice name, or a path to a .wav to clone
TURN_DETECTOR=                                 # blank = VAD endpointing; "soulx" needs the optional
                                               #   SoulX-Duplug server on :8765 (see README, advanced)
# SOULX_URL=ws://127.0.0.1:8765               # override SoulX server address
# VOICE_LLM_MODEL=                            # use a different LLM for VOICE only (chat keeps LLM_MODEL)
# VOICE_LLM_URL=
# LEAD_FILLER=1                               # speak "let me check..." while slow tools run (0 = off)
# LEAD_FILLER_DELAY=0.4

# ---- assistant identity (optional; defaults shown) ----
ASSISTANT_NAME=Kronik
WAKE_WORD=kronik

# ---- generic device / pet display names (used in prompts + spoken responses) ----
VACUUM_NAME=the vacuum
CAR_NAME=the car
PET_NAME=the cat

# ==============================================================================
# INTEGRATIONS — all OFF by default. Prefer: python agent/onboard.py <name>
# ==============================================================================

# --- OpenCode background coding/research sessions (the run_agent / session tools) ---
OPENCODE_ENABLED=false

# --- WiZ smart lights (local UDP) ---
WIZ_ENABLED=false
WIZ_BROADCAST=255.255.255.255
WIZ_LIGHTS=                                    # e.g. bedside 1=aabbccddeeff,bedside 2=001122334455
# WIZ_PULSE=false                              # pulse the lights in sync with the agent's voice
# WIZ_PULSE_COLOR=255,140,40
# WIZ_PULSE_LAG_MS=150

# --- Nest thermostat (Google Smart Device Management cloud) ---
NEST_ENABLED=false
NEST_PROJECT_ID=
NEST_CLIENT_ID=
NEST_CLIENT_SECRET=
NEST_REFRESH_TOKEN=
NEST_DEVICE_ID=

# --- Tesla (Fleet API) ---
TESLA_ENABLED=false
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=
TESLA_DOMAIN=                                  # your public https domain (hosts the command-signing key)
TESLA_REGION_BASE=
TESLA_TOKEN_JSON=

# --- Roomba (local MQTT) ---
ROOMBA_ENABLED=false
ROOMBA_IP=
ROOMBA_BLID=
ROOMBA_PASSWORD=

# --- Ring cameras (cloud) ---
RING_ENABLED=false
RING_TOKEN_JSON=
RING_LISTEN_CREDENTIALS=
# VLM_URL=http://127.0.0.1:8083/v1            # optional: local vision model for camera descriptions
# VLM_MODEL=
# MAGE_RING_SEGMENT_SECONDS=8                  # experimental live commentary window
# MAGE_RING_SAMPLE_FPS=2
# MAGE_RING_MAX_PIXELS=150000                  # lower = faster Mage inference

# --- TV (Android / Google TV over ADB) ---
TV_ENABLED=false
TV_HOST=                                       # the TV's LAN IP

# --- PetLibro feeder (cloud) ---
PETLIBRO_ENABLED=false
PETLIBRO_EMAIL=
PETLIBRO_PWD_MD5=
PETLIBRO_COUNTRY=
PETLIBRO_TOKEN=
# PETLIBRO_TZ=America/Los_Angeles             # optional

# --- DoorDash (official dd-cli; credentials live in the macOS Keychain) ---
# WARNING: this integration places REAL orders that charge REAL money on the DoorDash
# account dd-cli is logged into. There is no onboarder — enable it deliberately. Order
# tools require an explicit spoken confirmation, and "roulette" surprise orders are capped
# by DOORDASH_ROULETTE_MAX_CENTS, but you are responsible for every charge. Leave it off
# unless you understand that. Setup: install dd-cli and log in, then set the flag below.
DOORDASH_ENABLED=false
# DD_CLI_PATH=~/.local/bin/dd-cli
# DOORDASH_ROULETTE_MAX_CENTS=8000             # default all-in surprise-order cap ($80)
