# Build the web UI, then serve the static bundle AND reverse-proxy the API/signaling with
# Caddy — so the SPA and its backend share one origin (same as the native Caddy setup).
# Build from the REPO ROOT:  docker build -f docker/Dockerfile.web -t kronik-web .
FROM node:20-slim AS build
WORKDIR /web
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM caddy:2
COPY --from=build /web/dist /srv
COPY docker/Caddyfile /etc/caddy/Caddyfile
