# ==============================================================================
# Docker stack config. Copy to the REPO ROOT as .env:   cp docker/.env.example .env
# docker compose reads it for BOTH variable substitution AND container env, so keep it here.
# (This is separate from agent/.env.local, which the native macOS setup uses.)
# ==============================================================================

# ---- LiveKit shared secret (used by the server, the token minter, and the agent) ----
# LiveKit requires at least 32 characters. Change this to a random string for anything
# beyond localhost testing (e.g. `openssl rand -hex 24`).
LIVEKIT_API_SECRET=dev-only-secret-change-me-0123456789

# ---- browser-facing signaling URL (what the token server hands the web client) ----
# The LiveKit JS SDK appends /rtc; the `web` service (Caddy) routes it to the media server.
# Must match how you actually reach the web UI. Default = the localhost dev origin.
#   LAN / remote: browsers block mic access on non-localhost HTTP, so serve the web UI over
#   HTTPS (front it with your own TLS or `ngrok http 8080`) and set this to that https/wss
#   origin, e.g.  LIVEKIT_PUBLIC_URL=wss://voice.example.com
LIVEKIT_PUBLIC_URL=ws://localhost:8080
# WEB_PORT=8080          # host port for the web UI (update LIVEKIT_PUBLIC_URL if you change it)

# ---- LLM: any OpenAI-compatible endpoint WITH tool calling (external — not in this stack) ----
# From inside a container the HOST machine is `host.docker.internal` (mapped for Linux in
# docker-compose.yml). So an LLM you run on the host at :11434 is reachable as below.
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama                 # any non-empty value for local servers
LLM_MODEL=qwen3:8b                    # a tool-calling model your endpoint actually serves
LLM_REASONING_EFFORT=none             # for hybrid-thinking models; drop if your endpoint rejects it

# ---- STT (faster-whisper — the Linux/Docker backend; auto-selected on non-Apple hosts) ----
# FASTER_WHISPER_MODEL=base.en        # CPU default (fast); small.en/medium.en = more accurate
#                                     # the CUDA image defaults to large-v3
# FASTER_WHISPER_DEVICE=              # blank = auto (cuda if available, else cpu)
# FASTER_WHISPER_COMPUTE=             # blank = int8 on cpu / float16 on cuda

# ---- TTS ----
POCKET_VOICE=jean                     # a pocket-tts voice name, or a path to a .wav to clone

# ---- assistant identity (optional; defaults shown) ----
ASSISTANT_NAME=Kronik
WAKE_WORD=kronik

# ---- integrations: all OFF by default ----
# Enable per agent/.env.local.example + `onboard.py`. Note: LAN-discovery integrations
# (WiZ lights, Roomba, Google TV) need the agent container to see your LAN — that usually
# means running the agent with host networking. See docker/README.md.
